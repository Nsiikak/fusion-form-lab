# Leave empty for local dev (uses Vite proxy). Set to deployed URL for production.
# VITE_API_URL=https://plagohive-backend.onrender.com
VITE_PAYSTACK_PUBLIC_KEY=pk_test_a6976b612cae8f3c9328f9a29f73b02a60cc5680

# ── Environment ───────────────────────────────
# Set to "production" when deploying
ENVIRONMENT=development

# ── Cloudinary (production image uploads) ────
# Sign up at https://cloudinary.com and get your credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email / SMTP ──────────────────────────────
# For Gmail: enable 2FA and generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Plagohive
EMAIL_FROM_ADDRESS=your-email@gmail.com
FRONTEND_URL=https://plagohive.netlify.app
