# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/plagohive
SECRET_KEY=  # python -c "import secrets; print(secrets.token_hex(32))"
ENVIRONMENT=development  # set to "production" in prod — enables strict config checks
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Paystack — use sk_test_/pk_test_ keys until launch
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Fees (defaults shown)
PLATFORM_CUSTOMER_FEE_RATE=0.025   # charged to customer at checkout
VENDOR_COMMISSION_RATE=0.10        # deducted from vendor payout, never shown to customers
CHECKOUT_EXPIRY_MINUTES=60         # unpaid checkouts are cancelled after this

MONO_SECRET_KEY=
MONO_PUBLIC_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Plagohive
EMAIL_FROM_ADDRESS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_ALERT_EMAILS=                # comma-separated; emailed when a dispute is opened